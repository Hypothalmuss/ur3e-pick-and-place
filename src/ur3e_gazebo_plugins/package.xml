<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur3e_gazebo_plugins</name>
  <version>0.1.0</version>
  <description>
    Gazebo-classic model plugins for the UR3e workcell: a PID mimic-joint
    plugin (couples the Robotiq finger joints) and the JenniferBuehler
    GazeboGraspFix contact-based grasp stabiliser.
  </description>
  <maintainer email="roboticai@eagleprojects.tn">Eagle Robotics</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_plugin_path="${prefix}/lib"/>
  </export>
</package>
