<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur3e_with_effector">
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur3e"/>
  <xacro:arg name="sim_gazebo" default="true"/>
  <xacro:arg name="simulation_controllers" default="$(find ur3e_sim_bringup)/config/ros2_controllers.yaml"/>
  <xacro:arg name="initial_positions_file" default="$(find ur_description)/config/initial_positions.yaml"/>
  <xacro:arg name="use_grasp_plugins" default="true"/>
  <xacro:arg name="use_mimic_plugin" default="true"/>
  <!-- The grasp plugin held the target kinematically and teleported it each
       tick, so it ignored gravity, could not be moved in the Gazebo GUI, and
       snapped to the floor on release. The gripper grips by friction now, so
       it is off by default. Set use_grasp_fix:=true to get the old behaviour. -->
  <xacro:arg name="use_grasp_fix" default="false"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/ur_to_robotiq_adapter.urdf.xacro"/>
  <xacro:include filename="$(find ur3e_sim_bringup)/urdf/robotiq_2f_85_macro.urdf.xacro"/>

  <link name="world"/>

  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix=""
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"
    sim_gazebo="$(arg sim_gazebo)"
    initial_positions="${xacro.load_yaml('$(arg initial_positions_file)')}"
    generate_ros2_control_tag="false"
  >
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <xacro:if value="$(arg sim_gazebo)">
    <gazebo reference="world"/>
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>$(arg simulation_controllers)</parameters>
      </plugin>
    </gazebo>

    <ros2_control name="CombinedHardware" type="system">
      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>

      <joint name="shoulder_pan_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="shoulder_lift_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="elbow_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="wrist_1_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="wrist_2_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="wrist_3_joint">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Only the driver knuckle is controlled by ros2_control (gripper_controller).
           The other Robotiq finger joints are coupled in physics by the PID
           mimic-joint plugin below (gazebo_ros2_control 0.4.10 has no mimic
           support), and their TF is derived from the URDF <mimic> tags. -->
      <joint name="robotiq_85_left_knuckle_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <xacro:if value="$(arg use_mimic_plugin)">
    <!-- Couple the passive Robotiq finger joints to the driver knuckle.
         The two contact pads hang off the inner-knuckle and finger-tip joints,
         so those four run PID force control (usePID) and can stall against a
         grasped object. gazebo_ros2_control drives the knuckle itself by
         kinematic SetPosition, which cannot stall - a pad on that joint would
         simply squeeze the object out instead of holding it. -->
    <gazebo>
      <plugin filename="libur3e_mimic_joint_plugin.so" name="mimic_right_knuckle">
        <joint>robotiq_85_left_knuckle_joint</joint>
        <mimicJoint>robotiq_85_right_knuckle_joint</mimicJoint>
        <multiplier>-1.0</multiplier>
        <maxEffort>20.0</maxEffort>
        <kp>15.0</kp><kd>0.5</kd>
      </plugin>
      <plugin filename="libur3e_mimic_joint_plugin.so" name="mimic_left_inner_knuckle">
        <joint>robotiq_85_left_knuckle_joint</joint>
        <mimicJoint>robotiq_85_left_inner_knuckle_joint</mimicJoint>
        <multiplier>1.0</multiplier>
        <maxEffort>2.0</maxEffort>
        <kp>6.0</kp><kd>0.05</kd>
        <usePID>true</usePID>
      </plugin>
      <plugin filename="libur3e_mimic_joint_plugin.so" name="mimic_right_inner_knuckle">
        <joint>robotiq_85_left_knuckle_joint</joint>
        <mimicJoint>robotiq_85_right_inner_knuckle_joint</mimicJoint>
        <multiplier>-1.0</multiplier>
        <maxEffort>2.0</maxEffort>
        <kp>6.0</kp><kd>0.05</kd>
        <usePID>true</usePID>
      </plugin>
      <plugin filename="libur3e_mimic_joint_plugin.so" name="mimic_left_finger_tip">
        <joint>robotiq_85_left_knuckle_joint</joint>
        <mimicJoint>robotiq_85_left_finger_tip_joint</mimicJoint>
        <multiplier>-1.0</multiplier>
        <maxEffort>2.0</maxEffort>
        <kp>6.0</kp><kd>0.05</kd>
        <usePID>true</usePID>
      </plugin>
      <plugin filename="libur3e_mimic_joint_plugin.so" name="mimic_right_finger_tip">
        <joint>robotiq_85_left_knuckle_joint</joint>
        <mimicJoint>robotiq_85_right_finger_tip_joint</mimicJoint>
        <multiplier>1.0</multiplier>
        <maxEffort>2.0</maxEffort>
        <kp>6.0</kp><kd>0.05</kd>
        <usePID>true</usePID>
      </plugin>
    </gazebo>
    </xacro:if>

    <xacro:if value="$(arg use_grasp_fix)">
    <!-- Attach-on-close grasp. When the driver knuckle closes past the
         threshold, the nearest dynamic model within reach of the gripper is
         rigidly fixed to wrist_3_link (the merged gripper base), and released
         when the gripper reopens. Deterministic and crash-free. -->
    <gazebo>
      <plugin filename="libur3e_gripper_grasp_plugin.so" name="gripper_grasp">
        <gripper_joint>robotiq_85_left_knuckle_joint</gripper_joint>
        <palm_link>wrist_3_link</palm_link>
        <left_finger_link>robotiq_85_left_finger_tip_link</left_finger_link>
        <right_finger_link>robotiq_85_right_finger_tip_link</right_finger_link>
        <!-- Thresholds must sit below the closing angle the orchestrator actually
             commands. That angle is derived from the object width (a 0.06 m cube
             closes the knuckle to ~0.27 rad, not the 0.70 rad it used to command),
             so a 0.35 rad attach threshold would never latch. -->
        <attach_threshold>0.20</attach_threshold>
        <detach_threshold>0.08</detach_threshold>
        <grasp_radius>0.14</grasp_radius>
        <palm_offset_z>0.16</palm_offset_z>
        <update_rate>25</update_rate>
      </plugin>
    </gazebo>
    </xacro:if>
  </xacro:if>

  <xacro:ur_to_robotiq
    prefix=""
    connected_to="tool0"
    rotation="0"
  />

  <xacro:robotiq_gripper
    name="gripper"
    prefix=""
    parent="gripper_mount_link"
    include_ros2_control="false"
  >
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_gripper>

  <!-- The passive Robotiq finger links are driven kinematically by the mimic
       plugin. Because the 4-bar linkage is a tree (not a closed loop) in URDF,
       the independently-driven links overlap slightly and Gazebo's contact
       solver ejects them (pieces fly off). collide_bitmask 0x00 makes them
       collide with nothing, which stops that. They still render and move
       visually. This applies to the intermediate linkage only - the two pads
       that actually touch the object need real contact, see below. -->
  <xacro:macro name="finger_no_collision" params="link">
    <gazebo reference="${link}">
      <collision>
        <surface>
          <contact>
            <collide_bitmask>0x00</collide_bitmask>
          </contact>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <!-- The two finger pads are the only links that should touch the object. They
       carry the grip, so they get real contact and high friction. The knuckle is
       position controlled to the object's own width, which makes the pads behave
       as a rigid clamp - the object is squeezed between them and held by
       friction, rather than being carried by a plugin. -->
  <xacro:macro name="finger_pad_contact" params="link">
    <gazebo reference="${link}">
      <mu1>3.0</mu1>
      <mu2>3.0</mu2>
      <!-- Must match the cube's kp in ur3e_workcell.world. ODE combines the
           stiffness of both surfaces, so leaving the pad at 1e6 keeps the
           contact hard no matter how soft the object is. -->
      <kp>1e5</kp>
      <kd>1.0</kd>
      <minDepth>0.0</minDepth>
      <maxVel>0.01</maxVel>
    </gazebo>
  </xacro:macro>
  <xacro:finger_pad_contact link="robotiq_85_left_finger_tip_link"/>
  <xacro:finger_pad_contact link="robotiq_85_right_finger_tip_link"/>

  <xacro:finger_no_collision link="robotiq_85_left_inner_knuckle_link"/>
  <xacro:finger_no_collision link="robotiq_85_right_inner_knuckle_link"/>
  <xacro:finger_no_collision link="robotiq_85_left_knuckle_link"/>
  <xacro:finger_no_collision link="robotiq_85_right_knuckle_link"/>
  <xacro:finger_no_collision link="robotiq_85_left_finger_link"/>
  <xacro:finger_no_collision link="robotiq_85_right_finger_link"/>

</robot>
